# LoanHub production domains
ENVIRONMENT=production
APP_TIMEZONE=Africa/Maseru
# Production identity is stable. Changing this on an existing VPS changes Docker named-volume prefixes.
COMPOSE_PROJECT_NAME=loanhub
LOANHUB_ENV_FILE=.env.production
APP_DOMAIN=loanhub.co.ls
API_DOMAIN=api.loanhub.co.ls
WWW_DOMAIN=www.loanhub.co.ls
SANDBOX_APP_DOMAIN=sandbox.loanhub.co.ls
SANDBOX_API_DOMAIN=api-sandbox.loanhub.co.ls
TLS_EMAIL=replace-with-real-admin-email
PUBLIC_APP_URL=https://loanhub.co.ls
CORS_ORIGINS=https://loanhub.co.ls
NEXT_PUBLIC_API_URL=https://api.loanhub.co.ls/api/v1

# Production application images are built by GitHub Actions and published under the current repository owner.
LOANHUB_BACKEND_IMAGE=ghcr.io/ithute-stak/loanhub-backend
LOANHUB_FRONTEND_IMAGE=ghcr.io/ithute-stak/loanhub-frontend
LOANHUB_IMAGE_TAG=latest

# Keep application ports private on the VPS. Caddy is the only public entry point.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000
FRONTEND_BIND=127.0.0.1
FRONTEND_PORT=3000

# Core database and application secrets
DB_NAME=loanhub
DB_USER=loanhub
DB_PASSWORD=replace-with-long-random-password
SECRET_KEY=replace-with-long-random-secret
# Master key for encrypted control-plane secrets stored in PostgreSQL, including company CDAS and LelefaPayGate credentials.
FERNET_SECRET_KEY=replace-with-valid-fernet-key
CHAT_ENCRYPTION_KEY=replace-with-separate-long-random-secret
FILE_ENCRYPTION_KEY=replace-with-separate-long-random-secret
WEB_CONCURRENCY=2
RELEASE_TAG=production

# CDAS Test/Live URL, username and password are configured per company in
# LoanHub Company Settings. Passwords are encrypted in PostgreSQL.
CDAS_TIMEOUT_SECONDS=20

# Central !thute Auth migration. Leave disabled during deployment until the
# central Auth DNS/TLS service is healthy and account linking is scheduled.
ITHUTE_AUTH_ENABLED=false
ITHUTE_AUTH_ISSUER=https://auth.ithute.co.ls
ITHUTE_AUTH_AUDIENCE=loanhub
ITHUTE_AUTH_JWKS_URL=https://auth.ithute.co.ls/.well-known/jwks.json

# First production system-owner bootstrap. The phone is stable. The password must
# be supplied privately in .env.production or through the protected owner-recovery workflow.
BOOTSTRAP_SUPERADMIN_ENABLED=true
BOOTSTRAP_SUPERADMIN_PHONE=59001394
BOOTSTRAP_SUPERADMIN_PASSWORD=replace-with-long-random-bootstrap-password

# Security and abuse controls
RATE_LIMIT=100/minute
AUTH_RATE_LIMIT=10/minute
AUTH_LOCKOUT_MAX_ATTEMPTS=5
AUTH_LOCKOUT_MINUTES=15
RATE_LIMIT_ENABLED=true
ENABLE_ROLE_IMPERSONATION=false

# Signed outbound company webhooks
WEBHOOK_DELIVERY_TIMEOUT_SECONDS=10
WEBHOOK_DELIVERY_MAX_ATTEMPTS=8
WEBHOOK_DELIVERY_BATCH_SIZE=50

# Managed files. Use local on one VPS; use s3 for MinIO/AWS-compatible scale-out.
FILE_STORAGE_PATH=/app/storage/uploads
FILE_STORAGE_BACKEND=local
S3_ENDPOINT_URL=
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=loanhub
S3_ADDRESSING_STYLE=path
MALWARE_SCAN_ENABLED=false
MALWARE_SCAN_FAIL_CLOSED=true
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_TIMEOUT_SECONDS=5

# Controlled employee calling. Leave disabled until WebRTC/SIP infrastructure is ready.
# Never commit LiveKit API secrets to GitHub; inject them as deployment secrets.
CALL_MEDIA_PROVIDER=disabled
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CALL_TOKEN_TTL_SECONDS=300

# Optional Docker Compose scale-out profile (MinIO).
MINIO_ROOT_USER=loanhub-minio
MINIO_ROOT_PASSWORD=replace-with-long-random-minio-password

# Observability
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
