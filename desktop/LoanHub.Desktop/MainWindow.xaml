<Window x:Class="LoanHub.Desktop.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LoanHub Desktop | Phase 2" Width="1120" Height="730" MinWidth="900" MinHeight="610" WindowStartupLocation="CenterScreen" Background="{StaticResource Pale}">
 <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="275"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Grid.Column="0" Background="{StaticResource Navy}"><StackPanel Margin="28,38">
 <TextBlock Text="LoanHub" FontWeight="Bold" FontSize="31" Foreground="White"/>
 <TextBlock Text="WINDOWS DESKTOP · PHASE 2" FontSize="11" Foreground="#AAC5F3" Margin="0,2,0,46"/>
 <Button Content="Overview" Click="Home_Click" Height="45" Margin="0,0,0,10"/>
 <Button Content="Device registration" Click="Device_Click" Height="45" Margin="0,0,0,10"/>
 <Button Content="Connection settings" Click="Settings_Click" Height="45" Margin="0,0,0,10"/>
 <Button Content="Synchronization" Click="Sync_Click" Height="45" Margin="0,0,0,10"/>
 <Border BorderBrush="#3D5277" BorderThickness="0,1,0,0" Margin="0,40,0,12"/>
 <TextBlock Text="SECURITY STATUS" Foreground="#AAC5F3" FontSize="11"/>
 <TextBlock Text="Not authenticated" Foreground="White" Margin="0,8,0,3"/>
 <TextBlock Text="Server approval required" Foreground="#AAC5F3" TextWrapping="Wrap" FontSize="11"/>
 </StackPanel></Border>
 <Grid Grid.Column="1" Margin="42,30"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <DockPanel><TextBlock Text="LoanHub Desktop" FontWeight="Bold" FontSize="26" Foreground="{StaticResource Navy}" DockPanel.Dock="Left"/>
 <Border Background="#FFF0D2" CornerRadius="12" Padding="13,6" HorizontalAlignment="Right"><TextBlock Text="NOT AUTHORIZED" Foreground="#8A5900" FontWeight="SemiBold"/></Border></DockPanel>
 <Border Grid.Row="1" Background="White" CornerRadius="18" Padding="27" Margin="0,25,0,18">
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
 <TextBlock x:Name="PageTitle" Text="Welcome to LoanHub" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Navy}" TextWrapping="Wrap"/>
 <TextBlock x:Name="PageDescription" Text="Configure this Windows computer before connecting to LoanHub. Remote authorization is not enabled." FontSize="14" Foreground="#55637A" TextWrapping="Wrap" Margin="0,12,0,23"/>
 <TextBlock Text="LOCAL DEVICE IDENTIFIER" FontSize="12" FontWeight="Bold" Foreground="#344563"/>
 <TextBox x:Name="DeviceIdBox" IsReadOnly="True" Height="40" Padding="10" Margin="0,8,0,7" AutomationProperties.Name="Device ID"/>
 <TextBlock Text="Generated locally and protected for this Windows user. Not an approved device." FontSize="11" Foreground="#738198" TextWrapping="Wrap"/>
 <TextBlock Text="LOANHUB SERVER (HTTPS)" FontSize="12" FontWeight="Bold" Foreground="#344563" Margin="0,22,0,0"/>
 <TextBox x:Name="ServerBox" Height="40" Padding="10" Margin="0,8,0,10" Text="https://ithute.co.ls/" AutomationProperties.Name="Server URL"/>
 <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
 <Button Content="Save server" Click="SaveServer_Click" Width="130" Height="39" Margin="0,0,10,0"/>
 <Button Content="Check HTTPS" Click="CheckServer_Click" Width="140" Height="39"/>
 </StackPanel>
 <TextBlock Text="ACCOUNT EMAIL" FontSize="12" FontWeight="Bold" Foreground="#344563"/>
 <TextBox x:Name="EmailBox" Height="40" Padding="10" Margin="0,8,0,14" AutomationProperties.Name="Account email"/>
 <TextBlock Text="PASSWORD" FontSize="12" FontWeight="Bold" Foreground="#344563"/>
 <PasswordBox x:Name="PasswordInput" Height="40" Padding="10" Margin="0,8,0,14" AutomationProperties.Name="Account password"/>
 <Button Content="Sign in — awaiting approved server integration" IsEnabled="False" Height="43" Background="{StaticResource Blue}" Foreground="White" FontWeight="SemiBold"/>
 <TextBlock x:Name="StatusText" Text="Financial records and synchronization remain disabled." Foreground="#9A5700" TextWrapping="Wrap" Margin="0,15,0,0"/>
 </StackPanel></ScrollViewer></Border>
 <TextBlock Grid.Row="2" Text="LoanHub Desktop 0.2 · No remote authentication, offline financial storage or sync enabled" FontSize="12" Foreground="#738198"/>
 </Grid></Grid>
</Window>