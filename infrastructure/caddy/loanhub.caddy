loanhub.co.ls {
  header X-LoanHub-Service "web"
  header X-Content-Type-Options "nosniff"
  header X-Frame-Options "DENY"
  header Referrer-Policy "strict-origin-when-cross-origin"
  reverse_proxy loanhub-web:3000
}

www.loanhub.co.ls {
  redir https://loanhub.co.ls{uri} permanent
}

api.loanhub.co.ls {
  header X-LoanHub-Service "api"
  header X-Content-Type-Options "nosniff"
  header X-Frame-Options "DENY"
  header Referrer-Policy "strict-origin-when-cross-origin"
  reverse_proxy loanhub-api:8000
}
